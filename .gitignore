# Only reviewed source directories and public configuration may be committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Start-*.cmd
!/Stop-VR.cmd
!/src/
!/scripts/
!/tests/
!/release/
!/docs/
!/config/
/config/*
!/config/*.lock.json
!/config/target-fingerprint.json
!/config/observer-targets.json
!/config/pair-targets.json
!/config/native-targets.json
!/config/hp2vr.ini
!/config/vr/

# Local settings, game assets, build products and personal evidence stay local.
**/__pycache__/
**/*.pyc
**/*.exe
**/*.dll
**/*.pdb
**/*.o
**/*.obj
**/*.lib
**/*.a
**/*.zip
**/*.7z
**/*.log
**/*.jsonl
**/*.usa
**/*.unr
**/*.utx
**/*.uax
**/*.umx
**/*.u
**/.env
**/.env.*
**/*.pem
**/*.key
